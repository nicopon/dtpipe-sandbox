# =============================================================================
# Competitive Benchmark: dtpipe vs Meltano vs Sling
# Benchmark parameters and DB connections configuration
# =============================================================================

# --- Dataset Parameters ---
# Default row count when a 03-*.sh script is called directly (without --rows).
# When called via benchmarks.sh, this value is overridden by benchmarks.sh's own default (1000000).
BENCHMARK_ROWS=1000000

# Number of repetitions per benchmark (3 by default)
BENCHMARK_REPETITIONS=3

# --- Docker Network ---
BENCHMARK_NETWORK=benchmark-net

# --- PostgreSQL Configuration ---
DB_POSTGRES_HOST=${DB_POSTGRES_HOST:-dtpipe-integ-postgres}
DB_POSTGRES_PORT=${DB_POSTGRES_PORT:-5432}
DB_POSTGRES_DB=${DB_POSTGRES_DB:-integration}
DB_POSTGRES_USER=${DB_POSTGRES_USER:-postgres}
DB_POSTGRES_PASSWORD=${DB_POSTGRES_PASSWORD:-password}

# --- SQL Server (Azure SQL Edge) Configuration ---
DB_MSSQL_HOST=${DB_MSSQL_HOST:-dtpipe-integ-mssql}
DB_MSSQL_PORT=${DB_MSSQL_PORT:-1433}
DB_MSSQL_DB=${DB_MSSQL_DB:-master}
DB_MSSQL_USER=${DB_MSSQL_USER:-sa}
DB_MSSQL_PASSWORD=${DB_MSSQL_PASSWORD:-Password123!}

# --- Oracle Configuration ---
DB_ORACLE_HOST=${DB_ORACLE_HOST:-dtpipe-integ-oracle}
DB_ORACLE_PORT=${DB_ORACLE_PORT:-1521}
DB_ORACLE_SID=${DB_ORACLE_SID:-FREEPDB1}
DB_ORACLE_SERVICE=${DB_ORACLE_SERVICE:-FREEPDB1}
DB_ORACLE_USER=${DB_ORACLE_USER:-testuser}
DB_ORACLE_PASSWORD=${DB_ORACLE_PASSWORD:-password}

# --- Intra-DB transfer accounts (B13-B15) ---
# bench_reader: read-only on benchmark_source_* tables
# bench_writer: write-only on a dedicated schema (bench_tgt / BENCH_WRITER)
# Created automatically by 01-init-data.sh
DB_POSTGRES_READER_USER=${DB_POSTGRES_READER_USER:-bench_reader}
DB_POSTGRES_READER_PASSWORD=${DB_POSTGRES_READER_PASSWORD:-password}
DB_POSTGRES_WRITER_USER=${DB_POSTGRES_WRITER_USER:-bench_writer}
DB_POSTGRES_WRITER_PASSWORD=${DB_POSTGRES_WRITER_PASSWORD:-password}
DB_POSTGRES_WRITER_SCHEMA=${DB_POSTGRES_WRITER_SCHEMA:-bench_tgt}

DB_MSSQL_READER_USER=${DB_MSSQL_READER_USER:-bench_reader}
DB_MSSQL_READER_PASSWORD=${DB_MSSQL_READER_PASSWORD:-BenchReader1!}
DB_MSSQL_WRITER_USER=${DB_MSSQL_WRITER_USER:-bench_writer}
DB_MSSQL_WRITER_PASSWORD=${DB_MSSQL_WRITER_PASSWORD:-BenchWriter1!}
DB_MSSQL_WRITER_SCHEMA=${DB_MSSQL_WRITER_SCHEMA:-bench_tgt}

DB_ORACLE_READER_USER=${DB_ORACLE_READER_USER:-bench_reader}
DB_ORACLE_READER_PASSWORD=${DB_ORACLE_READER_PASSWORD:-password}
DB_ORACLE_WRITER_USER=${DB_ORACLE_WRITER_USER:-bench_writer}
DB_ORACLE_WRITER_PASSWORD=${DB_ORACLE_WRITER_PASSWORD:-password}
# DBA account used by 01-init-data.sh to CREATE USER (set to ORACLE_PASSWORD from docker-compose)
ORACLE_SYSTEM_PASSWORD=${ORACLE_SYSTEM_PASSWORD:-password}

# --- Benchmark Names (for filtering) ---
# Options: all, B01, B02, B03, B04, B05, B06, dtpipe, meltano, sling
BENCHMARK_SCOPE=${BENCHMARK_SCOPE:-all}
BENCHMARK_TOOL=${BENCHMARK_TOOL:-all}